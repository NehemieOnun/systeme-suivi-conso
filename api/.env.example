# Copier ce fichier en .env pour le développement local (ne jamais le publier sur GitHub)

# Chaîne de connexion PostgreSQL (Neon : Dashboard > Connection string)
DATABASE_URL=postgresql://utilisateur:motdepasse@localhost:5432/suivi_conso

# Secret de signature des jetons : 32 caractères aléatoires minimum
# Générer avec : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=remplacer_par_une_longue_chaine_aleatoire

# Adresse(s) autorisée(s) du tableau de bord, séparées par des virgules
CORS_ORIGIN=http://localhost:8080

PORT=3000
